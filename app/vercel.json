{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "t",
          "value": "(?<tok>[A-Za-z0-9_-]+)"
        }
      ],
      "destination": "/api/og?type=t&id=:tok"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/og?type=s&id=:slug"
    },
    {
      "source": "/r/:token",
      "destination": "/api/og?type=r&id=:token"
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://maipblnldvmvttfjbmsc.supabase.co",
      "VITE_SUPABASE_KEY": "sb_publishable_W_2Ry1BgRQFu9QRswvi3iA_jMQ1Dzvy"
    }
  }
}
